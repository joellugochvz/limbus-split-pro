<Window x:Class="LimbusSplitPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LimbusSplitPro.App"
        Title="Limbus Split Pro"
        MinWidth="1000" MinHeight="640" Width="1180" Height="760"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Tarjeta de instrumento del selector "Qué extraer" (sección 5) -->
        <Style x:Key="StemCardStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="CardBorder"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1.2" CornerRadius="8" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"
                                           Foreground="{StaticResource AccentBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                                <Ellipse Grid.Column="2" Width="12" Height="12" VerticalAlignment="Center"
                                         Fill="{StaticResource AccentBrush}"
                                         Visibility="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentSelectedBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource DisabledOverlayBrush}" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="0,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botones Mute/Solo del mezclador: pastilla compacta y cuadrada, con color
             de acento cuando está activo. Tamaño fijo para que todas las filas alineen
             exactamente igual sin importar el contenido. -->
        <Style x:Key="MixerToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder" CornerRadius="6" Background="{StaticResource DisabledOverlayBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fader de volumen: carril delgado, thumb circular con acento. Ancho fijo para
             que todos los faders del mezclador queden alineados en columna. -->
        <Style x:Key="FaderSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="110" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource CardBorderBrush}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Height="4">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Height="4" Background="Transparent" BorderThickness="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="13" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource AccentBrush}" Stroke="White" StrokeThickness="1.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera: logo, nombre, procesamiento local (sección 3) -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12"
                Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="9" Background="{StaticResource PrimaryButtonBrush}" Margin="0,0,10,0">
                        <TextBlock Text="&#xE71E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AccentBrush}"
                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="Bold">
                            <Run Text="LIMBUS " Foreground="{StaticResource AccentBrush}" />
                            <Run Text="SPLIT PRO" Foreground="{StaticResource TextPrimaryBrush}" />
                        </TextBlock>
                        <TextBlock Text="Separación multipista local" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource DisabledOverlayBrush}" CornerRadius="14" Padding="10,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="PROCESAMIENTO LOCAL" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Cuerpo: panel izquierdo (mezcla/qué extraer/carpeta) + panel derecho (resultado/mezclador) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== PANEL IZQUIERDO ===== -->
            <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="01 · MEZCLA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <Border x:Name="DropZoneBorder" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.5" CornerRadius="10"
                                Padding="20" Background="{StaticResource DisabledOverlayBrush}"
                                AllowDrop="True" DragOver="DropZoneBorder_DragOver" Drop="DropZoneBorder_Drop">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons" FontSize="22" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Suelta aquí tu mezcla" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="WAV, AIFF, MP3 o FLAC" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,2,0,10" />
                                <Button Content="Elegir archivo" Style="{StaticResource PillButtonStyle}"
                                        Command="{Binding ChooseFileCommand}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Aún no hay archivo cargado." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasNoLoadedFile, Converter={StaticResource BoolToVis}}" />

                        <!-- Archivo cargado, con metadatos reales leídos por AudioFileInspector (sección 4, punto 2) -->
                        <Border Visibility="{Binding HasLoadedFile, Converter={StaticResource BoolToVis}}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="10" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource AccentBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding LoadedFileName}" FontWeight="SemiBold" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LoadedFileInfo}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Separator Margin="0,16" Opacity="0.4" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="02 · QUÉ EXTRAER" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Todas" Style="{StaticResource PillButtonStyle}" Padding="10,3"
                                        Command="{Binding SelectAllCommand}" Margin="0,0,6,0" />
                                <Button Content="Ninguna" Style="{StaticResource PillButtonStyle}" Padding="10,3"
                                        Command="{Binding SelectNoneCommand}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding StemOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource StemCardStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsAvailable}"
                                                  ToolTip="{Binding UnavailableReason}"
                                                  Margin="0,0,5,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{StaticResource DisabledOverlayBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="&#x2699; " FontFamily="Segoe Fluent Icons" />
                                <Run Text="&quot;Other&quot; reúne lo no seleccionado. Las categorías deshabilitadas no tienen todavía un modelo con licencia comercial verificada (ver docs/01-modelos-licencias.md)." />
                            </TextBlock>
                        </Border>

                        <!-- Instalacion opcional de Demucs, SOLO uso personal (seccion 7):
                             se dispara unicamente con este clic explicito, nunca en silencio.
                             Desaparece una vez instalado. -->
                        <Border Visibility="{Binding NeedsDemucsInstall, Converter={StaticResource BoolToVis}}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="10" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8">
                                    <Run Text="Guitarra y piano requieren Demucs, un motor adicional cuya licencia de pesos no está confirmada — solo se ofrece para uso personal, nunca se distribuye." />
                                </TextBlock>
                                <Button Content="{Binding InstallDemucsLabel}" Style="{StaticResource PillButtonStyle}"
                                        Command="{Binding InstallDemucsCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,16" Opacity="0.4" />

                        <TextBlock Text="03 · CARPETA DE TRABAJO" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource AccentBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WorkingFolderPath, TargetNullValue='Sin seleccionar', FallbackValue='Sin seleccionar'}"
                                               FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Cambiar" Style="{StaticResource PillButtonStyle}"
                                        Command="{Binding ChooseFolderCommand}" />
                            </Grid>
                        </Border>

                        <Button Content="{Binding SeparateButtonLabel}" Style="{StaticResource PrimaryActionButtonStyle}"
                                Command="{Binding SeparateCommand}" Margin="0,18,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== PANEL DERECHO ===== -->
            <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="RESULTADO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />

                        <!-- Reproductor general (sección 14-15): solo visible con pistas cargadas -->
                        <Grid Margin="0,12,0,0" Visibility="{Binding HasTracks, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding PlayPauseLabel}" Style="{StaticResource PillButtonStyle}"
                                    Command="{Binding PlayPauseCommand}" Margin="0,0,6,0" />
                            <Button Grid.Column="1" Content="Stop" Style="{StaticResource PillButtonStyle}"
                                    Command="{Binding StopCommand}" Margin="0,0,10,0" />
                            <!-- Seek arrastrando (sección 15): PreviewMouseLeftButtonDown/Up en code-behind
                                 evita que el timer de posición pelee con el arrastre del usuario. -->
                            <Slider x:Name="SeekSlider" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                                    Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay}"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding PositionText}" /><Run Text=" / " /><Run Text="{Binding DurationText}" />
                            </TextBlock>
                            <Button Grid.Column="4" Content="Exportar mezcla" Style="{StaticResource PillButtonStyle}"
                                    Command="{Binding ExportMixCommand}" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <!-- Estado vacío: todavía no hay pistas generadas (build sin backend instalado) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasNoTracks, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE993;" FontFamily="Segoe Fluent Icons" FontSize="34" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.5" Margin="0,0,0,10" />
                            <TextBlock Text="Las pistas WAV aparecerán aquí al terminar." FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Lista de pistas del mezclador (sección 16), se llena cuando haya separación real -->
                        <ListBox ItemsSource="{Binding Tracks}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />

                                            <!-- Grupo Mute/Solo, compacto -->
                                            <ToggleButton Grid.Column="2" Content="M" Style="{StaticResource MixerToggleStyle}"
                                                          IsChecked="{Binding IsMuted}" Margin="0,0,4,0" ToolTip="Silenciar" />
                                            <ToggleButton Grid.Column="3" Content="S" Style="{StaticResource MixerToggleStyle}"
                                                          IsChecked="{Binding IsSolo}" Margin="0,0,16,0" ToolTip="Solo" />

                                            <!-- Porcentaje + fader, alineados a la derecha del recuadro -->
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"
                                                       Text="{Binding VolumePercent, StringFormat={}{0:0}%}" />
                                            <Slider Grid.Column="5" Style="{StaticResource FaderSliderStyle}"
                                                    Minimum="0" Maximum="100" Value="{Binding VolumePercent}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
